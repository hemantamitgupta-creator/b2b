# ==============================================================================
# B2B Surgical Instruments Platform - Environment Configuration Example
# Copy this file to .env.local and populate with your Supabase project credentials.
# NEVER commit .env.local or expose service-role keys to browser client code.
# ==============================================================================

# Public Supabase URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon / Publishable Key (Safe for browser requests, governed by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (ONLY for server-side maintenance scripts if needed. NEVER prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
